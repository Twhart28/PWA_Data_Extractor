{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PWA Data Extractor",
  "version": "0.1.0",
  "identifier": "com.thomashart.pwa-data-extractor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4173"
  },
  "app": {
    "windows": [
      {
        "title": "PWA Data Extractor",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
